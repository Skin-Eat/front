# local(기본값) 이외의 값을 넣으면 SUPABASE_JWT_SECRET 미설정 시 서버가 500으로 막는다.
# 배포/데모 환경에서는 반드시 production 등으로 채울 것 (app/core/security.py 참고).
APP_ENV=local

# 가비아 DB호스팅(MySQL) 콘솔 > DB 접속 정보에서 확인. 호스트는 가비아가 주는 DB 접속 도메인,
# 포트는 기본 3306. DB(스키마) 이름은 가비아 콘솔에서 만든 이름으로 바꿀 것.
# 예: mysql+pymysql://아이디:비밀번호@접속도메인:3306/DB이름
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/skinbasket

# 인증은 DB 제공자와 무관하게 계속 Supabase Auth를 쓴다 (DB만 가비아로 옮긴 것 — Auth는 그대로).
# Supabase 프로젝트 설정 > API 에서 확인
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI (사진->음식 인식 / 분석 문장 생성 / 레시피 생성) - OpenAI API 키, platform.openai.com에서 발급
OPENAI_API_KEY=

# 쇼핑 연동: 네이버 쇼핑검색 오픈API가 2026-07-31부로 종료돼서 백엔드에서 뺐다.
# 쿠팡과 동일하게 프론트가 검색 결과 페이지로 딥링크만 여는 방식으로 처리 (README 참고).

# 로컬 개발 중 프론트(안드로이드 에뮬레이터)에서 허용할 origin. 콤마로 구분
CORS_ORIGINS=*
