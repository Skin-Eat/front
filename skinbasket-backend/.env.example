# local(기본값) 이외의 값을 넣으면 SUPABASE_JWT_SECRET 미설정 시 서버가 500으로 막는다.
# 배포/데모 환경에서는 반드시 production 등으로 채울 것 (app/core/security.py 참고).
APP_ENV=local

# Supabase 프로젝트 설정 > Database > Connection string (URI, "Session pooler" 권장)에서 복사
# 예: postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Supabase 프로젝트 설정 > API 에서 확인 (DB랑 같은 프로젝트 — 인증도 여기서 처리)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# anon(공개) key — API Keys 섹션에서 "anon public"이라고 표시된 값. service_role 아님!
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI (사진->음식 인식 / 분석 문장 생성 / 레시피 생성) - OpenAI API 키, platform.openai.com에서 발급
OPENAI_API_KEY=

# 쇼핑 연동: 네이버 쇼핑검색 오픈API가 2026-07-31부로 종료돼서 백엔드에서 뺐다.
# 쿠팡과 동일하게 프론트가 검색 결과 페이지로 딥링크만 여는 방식으로 처리 (README 참고).

# 로컬 개발 중 프론트(안드로이드 에뮬레이터)에서 허용할 origin. 콤마로 구분
CORS_ORIGINS=*
