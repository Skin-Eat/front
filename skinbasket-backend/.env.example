# local(기본값) 이외의 값을 넣으면 SUPABASE_JWT_SECRET 미설정 시 서버가 500으로 막는다.
# 배포/데모 환경에서는 반드시 production 등으로 채울 것 (app/core/security.py 참고).
APP_ENV=local

# Supabase 프로젝트 설정 > Database > Connection string (URI, "Session pooler" 권장)에서 복사
# 예: postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Supabase 프로젝트 설정 > API 에서 확인
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI (사진->음식 인식 / 분석 문장 생성 / 레시피 생성)
GEMINI_API_KEY=

# 쇼핑 연동 (네이버 검색 API - 개발자센터에서 "검색" API로 등록해야 함, 데이터랩 쇼핑API 아님)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 로컬 개발 중 프론트(안드로이드 에뮬레이터)에서 허용할 origin. 콤마로 구분
CORS_ORIGINS=*
